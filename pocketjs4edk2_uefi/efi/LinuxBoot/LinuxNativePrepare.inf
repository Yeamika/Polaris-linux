[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = LinuxNativePrepare
  FILE_GUID = 53a50969-5de0-4781-8ec2-c17dcf83083d
  MODULE_TYPE = UEFI_APPLICATION
  VERSION_STRING = 0.1
  ENTRY_POINT = UefiMain
[Sources]
  NativeJournal.c
  NativePrepare.c
  Handoff.c
  Initrd.c
  Diagnostics.c
  BootOutput.c
  NativeHandoff.c
  NativeEnterKernel.S
  ../Common/Loader.c
[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  Silicon/Qualcomm/QcomPkg/QcomPkg.dec
[LibraryClasses]
  CacheMaintenanceLib
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  BaseLib
  BaseMemoryLib
  DevicePathLib
  MemoryAllocationLib
  FdtLib
[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiGraphicsOutputProtocolGuid
  gEfiLoadFile2ProtocolGuid
  gEfiDevicePathProtocolGuid
[Guids]
  gEfiFileInfoGuid
  gFdtTableGuid
  gEfiEventExitBootServicesGuid
  gEfiEventReadyToBootGuid
