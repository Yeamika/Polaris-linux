+static bool polaris_dsi_rate_matches(unsigned long actual, unsigned long expected)
+{
+	unsigned long delta = actual > expected ? actual - expected : expected - actual;
+
+	/* Allow the fixed mode's kHz rounding, but reject another refresh rate. */
+	return actual && expected && delta <= expected / 1000;
+}
