+void msm_dsi_phy_release_boot_state(struct msm_dsi_phy *phy)
+{
+	if (!phy)
+		return;
+	phy->polaris_boot_adopted = false;
+	if (!phy->polaris_boot_resources)
+		return;
+
+	msm_dsi_phy_release_boot_clock(phy);
+	regulator_bulk_disable(phy->cfg->num_regulators, phy->supplies);
+	pm_runtime_put(&phy->pdev->dev);
+	phy->polaris_boot_resources = false;
