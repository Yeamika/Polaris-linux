+static int polaris_dsi_vote_boot_performance(struct msm_dsi_host *msm_host)
+{
+	struct device *dev = &msm_host->pdev->dev;
+	unsigned long freq = msm_host->byte_clk_rate;
+	struct dev_pm_opp *opp;
+	unsigned int state;
+
+	/* SDM845 DSI has one CX domain. Preserve its OPP voltage vote while
+	 * leaving validated live PLL/divider rates untouched, including DCS.
+	 */
+	opp = dev_pm_opp_find_freq_ceil(dev, &freq);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+	state = dev_pm_opp_get_required_pstate(opp, 0);
+	dev_pm_opp_put(opp);
+	if (!state)
+		return -EPROBE_DEFER;
+	return dev_pm_domain_set_performance_state(dev, state);
+}
