+bool msm_dsi_host_adopt_boot_state(struct mipi_dsi_host *host,
+				  struct msm_dsi_phy *phy)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	struct drm_display_mode *mode = msm_host->mode;
+	struct device *dev = &msm_host->pdev->dev;
+	unsigned long pixel, byte, intf, expected;
+	u32 ctrl, ah, av, total, hs, vs, vsh, video, lane_mask;
+	bool valid;
+	int ret;
+
+	if (!msm_dsi_phy_boot_state_live(phy) || msm_host->id != DSI_0 ||
+	    !mode || mode->hdisplay != 1080 || mode->vdisplay != 2160 ||
+	    msm_host->dsc || msm_host->cphy_mode || msm_host->lanes != 4 ||
+	    msm_host->format != MIPI_DSI_FMT_RGB888 || msm_host->channel ||
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
+		return false;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return false;
+	msm_host->polaris_boot_pm = true;
+
+	ctrl = dsi_read(msm_host, REG_DSI_CTRL);
+	ah = dsi_read(msm_host, REG_DSI_ACTIVE_H);
+	av = dsi_read(msm_host, REG_DSI_ACTIVE_V);
+	total = dsi_read(msm_host, REG_DSI_TOTAL);
+	hs = dsi_read(msm_host, REG_DSI_ACTIVE_HSYNC);
+	vs = dsi_read(msm_host, REG_DSI_ACTIVE_VSYNC_VPOS);
+	vsh = dsi_read(msm_host, REG_DSI_ACTIVE_VSYNC_HPOS);
+	video = dsi_read(msm_host, REG_DSI_VID_CFG0);
+	pixel = clk_get_rate(msm_host->pixel_clk);
+	byte = clk_get_rate(msm_host->byte_clk);
+	intf = clk_get_rate(msm_host->byte_intf_clk);
+	expected = mode->clock * 1000UL;
+	lane_mask = DSI_CTRL_LANE0 | DSI_CTRL_LANE1 | DSI_CTRL_LANE2 | DSI_CTRL_LANE3;
+
+	valid = (ctrl & (DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN | DSI_CTRL_CLK_EN |
+			 lane_mask)) == (DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN |
+					DSI_CTRL_CLK_EN | lane_mask) &&
+		ah == (DSI_ACTIVE_H_START(mode->htotal - mode->hsync_start) |
+		       DSI_ACTIVE_H_END(mode->htotal - mode->hsync_start + mode->hdisplay)) &&
+		av == (DSI_ACTIVE_V_START(mode->vtotal - mode->vsync_start) |
+		       DSI_ACTIVE_V_END(mode->vtotal - mode->vsync_start + mode->vdisplay)) &&
+		total == (DSI_TOTAL_H_TOTAL(mode->htotal - 1) |
+			  DSI_TOTAL_V_TOTAL(mode->vtotal - 1)) &&
+		hs == DSI_ACTIVE_HSYNC_END(mode->hsync_end - mode->hsync_start) &&
+		!vsh &&
+		vs == DSI_ACTIVE_VSYNC_VPOS_END(mode->vsync_end - mode->vsync_start) &&
+		(video & DSI_VID_CFG0_DST_FORMAT__MASK) ==
+			DSI_VID_CFG0_DST_FORMAT(dsi_get_vid_fmt(msm_host->format)) &&
+		polaris_dsi_rate_matches(pixel, expected) &&
+		polaris_dsi_rate_matches(byte, expected * 3 / 4) &&
+		/* Independent divider recalc can round a half-rate upward by 1 Hz. */
+		(intf == byte || (intf &&
+		 (intf * 2 == byte || intf * 2 == byte + 1 || intf * 2 + 1 == byte))) &&
+		msm_dsi_phy_boot_state_live(phy);
+
+	dev_info(dev,
+		 "POLARIS_DSI: host match=%d ctrl=%#x active=%#x/%#x total=%#x sync=%#x/%#x vsh=%#x video=%#x clocks=%lu/%lu/%lu\n",
+		 valid, ctrl, ah, av, total, hs, vs, vsh, video, pixel, byte, intf);
+	if (!valid) {
+		msm_dsi_host_release_boot_pm(host);
+		return false;
+	}
+
+	msm_host->pixel_clk_rate = pixel;
+	msm_host->byte_clk_rate = byte;
+	msm_host->byte_intf_clk_rate = intf;
+	msm_host->esc_clk_rate = clk_get_rate(msm_host->esc_clk);
+	msm_host->polaris_boot_handoff = true;
+	phy->polaris_boot_adopted = true;
+	return true;
+}
