# Polaris desktop hardware kernel; REIMUKS selects desktop/server userspace.
CONFIG_LOCALVERSION="-polaris-desktop"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ZBOOT=n
CONFIG_ACPI=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_PANEL_NOVATEK_NT35596S=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_FB_EFI=n
CONFIG_FB_SIMPLE=n
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=n
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_POLARIS_BOOT_DISPLAY=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F12=y
# The upstream SDM845 fragment also enables a broken unrelated ST FTS driver.
# Polaris uses the RMI4 I2C controller above.
CONFIG_TOUCHSCREEN_STMFTS=n
CONFIG_INPUT_EVDEV=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_NOWAYOUT=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_RUST=n
CONFIG_MODULE_COMPRESS=n
CONFIG_MODULE_COMPRESS_ALL=n
CONFIG_MODULE_COMPRESS_ZSTD=n
CONFIG_MODULE_COMPRESS_XZ=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_CMDLINE=""
CONFIG_CMDLINE_FORCE=n

# SDM845 RPMh depends on the PSCI cluster domain even during early USB/UFS boot.
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y

# SDM845 cpufreq IRQs are supplied by LMh; enable its thermal framework.
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_LMH=y
